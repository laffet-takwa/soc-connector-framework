# Copy to .env and fill in. NEVER commit the real .env — it is gitignored.
# Every value below is read from the environment at runtime; nothing is hardcoded.
# The demo works with all of these left unset (connectors fall back to local fixtures
# and forwarders write to data/output/).

# --- AWS CloudTrail connector -----------------------------------------------------
# Only needed for mode=s3. Use a read-only IAM identity scoped to
# s3:GetObject + s3:ListBucket on the CloudTrail bucket (see docs/security.md).
SOC_CLOUDTRAIL_MODE=local
SOC_AWS_ACCESS_KEY_ID=
SOC_AWS_SECRET_ACCESS_KEY=
SOC_AWS_SESSION_TOKEN=
SOC_AWS_REGION=us-east-1
SOC_CLOUDTRAIL_BUCKET=
SOC_CLOUDTRAIL_PREFIX=AWSLogs/111122223333/CloudTrail/

# --- Microsoft Entra ID connector -------------------------------------------------
# App registration with the application permission AuditLog.Read.All only.
# Add Policy.Read.All if you need appliedConditionalAccessPolicies in the payload.
SOC_ENTRA_ENABLED=false
SOC_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
SOC_ENTRA_CLIENT_ID=
SOC_ENTRA_CLIENT_SECRET=
SOC_ENTRA_SCOPE=https://graph.microsoft.com/.default

# --- Syslog / firewall connector --------------------------------------------------
SOC_SYSLOG_BIND=127.0.0.1
SOC_SYSLOG_UDP_PORT=5514
SOC_SYSLOG_TCP_PORT=5515
SOC_SYSLOG_FORMAT=fortinet

# --- Elasticsearch forwarder ------------------------------------------------------
SOC_ELASTICSEARCH_ENABLED=false
SOC_ELASTICSEARCH_URL=http://127.0.0.1:9200
SOC_ELASTICSEARCH_INDEX=soc-events
SOC_ELASTICSEARCH_USERNAME=elastic
SOC_ELASTICSEARCH_PASSWORD=
SOC_ELASTICSEARCH_API_KEY=

# --- Wazuh forwarder (file output monitored by a Wazuh agent localfile) -----------
SOC_WAZUH_ENABLED=false
SOC_WAZUH_OUTPUT_PATH=data/output/wazuh-events.jsonl
SOC_WAZUH_SYSLOG_TARGET=

# --- TheHive forwarder (experimental, tested with mocks only) ---------------------
SOC_THEHIVE_ENABLED=false
SOC_THEHIVE_URL=http://127.0.0.1:9000
SOC_THEHIVE_API_KEY=
SOC_THEHIVE_ORGANIZATION=
SOC_THEHIVE_SEVERITY_THRESHOLD=75

# --- Runtime ----------------------------------------------------------------------
SOC_LOG_LEVEL=INFO
SOC_LOG_FORMAT=json
SOC_STATE_DIR=data/state
SOC_DEAD_LETTER_DIR=data/dead_letter
